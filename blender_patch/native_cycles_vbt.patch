+static const KernelVBTHeader *find_vbt_header_for_volume(Volume *volume)
+{
+  for (Attribute &attr : volume->attributes.attributes) {
+    if (attr.element != ATTR_ELEMENT_VOXEL) {
+      continue;
+    }
+
+    ImageHandle &handle = attr.data_voxel_for_write();
+    if (handle.empty()) {
+      continue;
+    }
+
+    device_image *image = handle.resident_image_memory();
+    if (image == nullptr || image->host_pointer == nullptr ||
+        image->info.data_type != IMAGE_DATA_TYPE_VBT_DENSITY ||
+        image->memory_size() < sizeof(KernelVBTHeader))
+    {
+      continue;
+    }
+
+    const KernelVBTHeader *header = static_cast<const KernelVBTHeader *>(image->host_pointer);
+    if (header->magic == KERNEL_VBT_BLOB_MAGIC && header->dim_x > 0u && header->dim_y > 0u &&
+        header->dim_z > 0u)
+    {
+      return header;
+    }
+  }
+
+  return nullptr;
+}
+
+static bool create_vbt_volume_box_mesh(Volume *volume, Shader *volume_shader)
+{
+  const KernelVBTHeader *header = find_vbt_header_for_volume(volume);
+  if (header == nullptr) {
+    return false;
+  }
+
+  (void)header;
+
+  const float3 vertices[8] = {
+      make_float3(0.0f, 0.0f, 0.0f),
+      make_float3(1.0f, 0.0f, 0.0f),
+      make_float3(1.0f, 1.0f, 0.0f),
+      make_float3(0.0f, 1.0f, 0.0f),
+      make_float3(0.0f, 0.0f, 1.0f),
+      make_float3(1.0f, 0.0f, 1.0f),
+      make_float3(1.0f, 1.0f, 1.0f),
+      make_float3(0.0f, 1.0f, 1.0f),
+  };
+  const int indices[36] = {
+      0, 2, 1, 0, 3, 2, 4, 5, 6, 4, 6, 7, 0, 1, 5, 0, 5, 4,
+      1, 2, 6, 1, 6, 5, 2, 3, 7, 2, 7, 6, 3, 0, 4, 3, 4, 7,
+  };
+
+  volume->resize_mesh(8, 12);
+  array<Node *> used_shaders;
+  used_shaders.push_back_slow(volume_shader);
+  volume->set_used_shaders(used_shaders);
+
+  std::copy(vertices, vertices + 8, volume->get_verts().data());
+  std::copy(indices, indices + 36, volume->get_triangles().data());
+  std::ranges::fill(volume->get_shader(), 0);
+  std::ranges::fill(volume->get_smooth(), false);
+
+  LOG_DEBUG << "Memory usage VBT volume mesh: "
+            << (sizeof(vertices) + sizeof(indices)) / (1024.0 * 1024.0) << "Mb.";
+
+  return true;
+}
