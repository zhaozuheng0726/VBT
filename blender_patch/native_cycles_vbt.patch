@@ -0,0 +1,470 @@
+/* SPDX-FileCopyrightText: 2026
+ *
+ * SPDX-License-Identifier: Apache-2.0 */
+
+#pragma once
+
+#include "util/types_image.h"
+
+CCL_NAMESPACE_BEGIN
+
+enum {
+  VBT_MODE_EMPTY = 0u,
+  VBT_MODE_TEMPORAL_GRID4 = 1u,
+  VBT_MODE_TEMPORAL_FINE_COMPACT_RESERVED = 2u,
+  VBT_MODE_TEMPORAL_FINE6 = 3u,
+  VBT_TIME_BIN_COUNT = 8u,
+};
+
+struct VBTPayloadView {
+  ccl_global const KernelVBTHeader *header;
+  ccl_global const uint *offset_words;
+  ccl_global const uint *payload_words;
+};
+
+ccl_device_inline uint vbt_min_u32(const uint a, const uint b)
+{
+  return a < b ? a : b;
+}
+
+ccl_device_inline uint vbt_max_u32(const uint a, const uint b)
+{
+  return a > b ? a : b;
+}
+
+ccl_device_inline int vbt_clamp_i32(const int v, const int lo, const int hi)
+{
+  return v < lo ? lo : (v > hi ? hi : v);
+}
+
+ccl_device_inline float vbt_clamp_f32(const float v, const float lo, const float hi)
+{
+  return v < lo ? lo : (v > hi ? hi : v);
+}
+
+ccl_device_inline float vbt_mix_f32(const float a, const float b, const float t)
+{
+  return a * (1.0f - t) + b * t;
+}
+
+ccl_device_inline uint vbt_align_up4(const uint bytes)
+{
+  return (bytes + 3u) & ~3u;
+}
+
+ccl_device_inline float vbt_uint_as_float(const uint bits)
+{
+  union {
+    uint u;
+    float f;
+  } cvt;
+  cvt.u = bits;
+  return cvt.f;
+}
+
+ccl_device_inline ccl_global const uint *vbt_blob_offsets(
+    ccl_global const KernelVBTHeader *header)
+{
+  return (ccl_global const uint *)(((ccl_global const uint8_t *)header) +
+                                  header->offsets_byte_offset);
+}
+
+ccl_device_inline ccl_global const uint *vbt_blob_payload(
+    ccl_global const KernelVBTHeader *header)
+{
+  return (ccl_global const uint *)(((ccl_global const uint8_t *)header) +
+                                  header->payload_byte_offset);
+}
+
+ccl_device_inline uint vbt_read_payload_byte(ccl_global const uint *payload,
+                                             const uint byte_offset)
+{
+  const uint word = payload[byte_offset >> 2u];
+  const uint shift = (byte_offset & 3u) * 8u;
+  return (word >> shift) & 0xffu;
+}
+
+ccl_device_inline uint vbt_read_payload_u16(ccl_global const uint *payload,
+                                            const uint byte_offset)
+{
+  return vbt_read_payload_byte(payload, byte_offset) |
+         (vbt_read_payload_byte(payload, byte_offset + 1u) << 8u);
+}
+
+ccl_device_inline float vbt_half_to_float(uint h)
+{
+  const uint sign = (h >> 15u) & 1u;
+  uint exponent = (h >> 10u) & 0x1fu;
+  uint mantissa = h & 0x3ffu;
+  uint bits = 0u;
+
+  if (exponent == 0u) {
+    if (mantissa == 0u) {
+      bits = sign << 31u;
+    }
+    else {
+      int e = -14;
+      while ((mantissa & 0x400u) == 0u) {
+        mantissa <<= 1u;
+        --e;
+      }
+      mantissa &= 0x3ffu;
+      bits = (sign << 31u) | (uint(e + 127) << 23u) | (mantissa << 13u);
+    }
+  }
+  else if (exponent == 31u) {
+    bits = (sign << 31u) | 0x7f800000u | (mantissa << 13u);
+  }
+  else {
+    bits = (sign << 31u) | ((exponent + 112u) << 23u) | (mantissa << 13u);
+  }
+
+  return vbt_uint_as_float(bits);
+}
+
+ccl_device_inline float vbt_read_keyframe_value(ccl_global const uint *payload,
+                                                const uint key_base,
+                                                const uint codec,
+                                                const uint key_index,
+                                                ccl_private uint *key_frame)
+{
+  if (codec == 1u) {
+    const uint offset = key_base + key_index * 8u;
+    *key_frame = vbt_read_payload_u16(payload, offset);
+    const uint bits = vbt_read_payload_byte(payload, offset + 4u) |
+                      (vbt_read_payload_byte(payload, offset + 5u) << 8u) |
+                      (vbt_read_payload_byte(payload, offset + 6u) << 16u) |
+                      (vbt_read_payload_byte(payload, offset + 7u) << 24u);
+    return vbt_uint_as_float(bits);
+  }
+
+  const uint offset = key_base + key_index * 3u;
+  *key_frame = vbt_read_payload_byte(payload, offset);
+  return vbt_half_to_float(vbt_read_payload_u16(payload, offset + 1u));
+}
+
+ccl_device_inline float vbt_decode_temporal_control_value(ccl_global const uint *payload,
+                                                          const uint stream_base,
+                                                          const uint codec,
+                                                          const uint control_count,
+                                                          const uint keyframe_count,
+                                                          const uint control_index,
+                                                          const int total_frames,
+                                                          const int frame_index)
+{
+  (void)keyframe_count;
+
+  const uint descriptor_bytes = control_count * 4u;
+  const uint bin_index_bytes = vbt_align_up4(control_count * VBT_TIME_BIN_COUNT);
+  const uint key_base = stream_base + descriptor_bytes + bin_index_bytes;
+
+  const uint desc_offset = stream_base + control_index * 4u;
+  const uint key_start = vbt_read_payload_u16(payload, desc_offset);
+  const uint key_count = vbt_read_payload_byte(payload, desc_offset + 2u);
+  const uint reserved = vbt_read_payload_byte(payload, desc_offset + 3u);
+
+  if (key_count == 0u) {
+    return 0.0f;
+  }
+  if (key_count == 1u) {
+    uint only_frame = 0u;
+    return vbt_read_keyframe_value(payload, key_base, codec, key_start, &only_frame);
+  }
+
+  const int clamped_frame = vbt_clamp_i32(frame_index, 0, total_frames > 0 ? total_frames - 1 : 0);
+  const uint safe_total_frames = vbt_max_u32(uint(total_frames), 1u);
+  const uint bin = vbt_min_u32(VBT_TIME_BIN_COUNT - 1u,
+                               (uint(clamped_frame) * VBT_TIME_BIN_COUNT) / safe_total_frames);
+  const uint bin_base = stream_base + descriptor_bytes + control_index * VBT_TIME_BIN_COUNT;
+  int begin_local = int(vbt_read_payload_byte(payload, bin_base + bin));
+  begin_local = vbt_clamp_i32(begin_local, 0, int(key_count) - 1);
+
+  int end_local = int(key_count);
+  for (int next = int(bin) + 1; next < int(VBT_TIME_BIN_COUNT); ++next) {
+    const int next_local = int(vbt_read_payload_byte(payload, bin_base + uint(next)));
+    if (next_local > begin_local) {
+      end_local = next_local < int(key_count) ? next_local : int(key_count);
+      break;
+    }
+  }
+
+  const int local_max_bin_keys = reserved != 0u ? int(reserved) : 8;
+  const int bounded_end = begin_local + (local_max_bin_keys > 1 ? local_max_bin_keys : 1);
+  end_local = end_local < bounded_end ? end_local : bounded_end;
+
+  int prev_local = begin_local;
+  int curr_local = begin_local;
+  while (curr_local < end_local) {
+    uint curr_frame = 0u;
+    const float curr_value = vbt_read_keyframe_value(
+        payload, key_base, codec, key_start + uint(curr_local), &curr_frame);
+    if (int(curr_frame) >= clamped_frame) {
+      if (int(curr_frame) <= clamped_frame || curr_local == prev_local) {
+        return curr_value;
+      }
+
+      uint prev_frame = 0u;
+      const float prev_value = vbt_read_keyframe_value(
+          payload, key_base, codec, key_start + uint(prev_local), &prev_frame);
+      const int f0 = int(prev_frame);
+      const int f1 = int(curr_frame);
+      if (f1 <= f0) {
+        return prev_value;
+      }
+
+      const float alpha = float(clamped_frame - f0) / float(f1 - f0);
+      return vbt_mix_f32(prev_value, curr_value, alpha);
+    }
+
+    prev_local = curr_local;
+    ++curr_local;
+  }
+
+  uint last_frame = 0u;
+  return vbt_read_keyframe_value(payload, key_base, codec, key_start + key_count - 1u, &last_frame);
+}
+
+ccl_device_inline float vbt_control_coord(const uint index, const uint resolution)
+{
+  return resolution <= 1u ? 0.0f : float(index) * (7.0f / float(resolution - 1u));
+}
+
+ccl_device_inline void vbt_locate_coord(const float p,
+                                        const uint extent,
+                                        const uint resolution,
+                                        ccl_private uint *i0,
+                                        ccl_private uint *i1,
+                                        ccl_private float *w)
+{
+  if (resolution <= 1u) {
+    *i0 = 0u;
+    *i1 = 0u;
+    *w = 0.0f;
+    return;
+  }
+
+  const float max_p = float(extent > 0u ? extent - 1u : 0u);
+  const float clamped = vbt_clamp_f32(p, 0.0f, max_p);
+  uint hi = 1u;
+  while (hi < resolution - 1u && vbt_control_coord(hi, resolution) < clamped) {
+    ++hi;
+  }
+
+  const uint lo = hi > 0u ? hi - 1u : 0u;
+  const float c0 = vbt_control_coord(lo, resolution);
+  const float c1 = vbt_control_coord(hi, resolution);
+  *i0 = lo;
+  *i1 = hi;
+  *w = c1 > c0 ? ((clamped - c0) / (c1 - c0)) : 0.0f;
+}
+
+ccl_device_inline uint vbt_control_index3(const uint x,
+                                          const uint y,
+                                          const uint z,
+                                          const uint resolution)
+{
+  return (z * resolution + y) * resolution + x;
+}
+
+ccl_device_inline float vbt_sample_control_stream(const VBTPayloadView vbt,
+                                                  const uint stream_base,
+                                                  const uint codec,
+                                                  const uint resolution,
+                                                  const uint keyframe_count,
+                                                  const uint leaf_width,
+                                                  const uint leaf_height,
+                                                  const uint leaf_depth,
+                                                  const float lx,
+                                                  const float ly,
+                                                  const float lz)
+{
+  if (resolution == 0u) {
+    return 0.0f;
+  }
+
+  uint x0 = 0u, x1 = 0u, y0 = 0u, y1 = 0u, z0 = 0u, z1 = 0u;
+  float tx = 0.0f, ty = 0.0f, tz = 0.0f;
+  vbt_locate_coord(lx, leaf_width, resolution, &x0, &x1, &tx);
+  vbt_locate_coord(ly, leaf_height, resolution, &y0, &y1, &ty);
+  vbt_locate_coord(lz, leaf_depth, resolution, &z0, &z1, &tz);
+
+  const uint control_count = resolution * resolution * resolution;
+  ccl_global const KernelVBTHeader *h = vbt.header;
+  ccl_global const uint *payload = vbt.payload_words;
+
+  const float v000 = vbt_decode_temporal_control_value(
+      payload, stream_base, codec, control_count, keyframe_count,
+      vbt_control_index3(x0, y0, z0, resolution), int(h->frames), int(h->frame_index));
+  const float v100 = vbt_decode_temporal_control_value(
+      payload, stream_base, codec, control_count, keyframe_count,
+      vbt_control_index3(x1, y0, z0, resolution), int(h->frames), int(h->frame_index));
+  const float v010 = vbt_decode_temporal_control_value(
+      payload, stream_base, codec, control_count, keyframe_count,
+      vbt_control_index3(x0, y1, z0, resolution), int(h->frames), int(h->frame_index));
+  const float v110 = vbt_decode_temporal_control_value(
+      payload, stream_base, codec, control_count, keyframe_count,
+      vbt_control_index3(x1, y1, z0, resolution), int(h->frames), int(h->frame_index));
+  const float v001 = vbt_decode_temporal_control_value(
+      payload, stream_base, codec, control_count, keyframe_count,
+      vbt_control_index3(x0, y0, z1, resolution), int(h->frames), int(h->frame_index));
+  const float v101 = vbt_decode_temporal_control_value(
+      payload, stream_base, codec, control_count, keyframe_count,
+      vbt_control_index3(x1, y0, z1, resolution), int(h->frames), int(h->frame_index));
+  const float v011 = vbt_decode_temporal_control_value(
+      payload, stream_base, codec, control_count, keyframe_count,
+      vbt_control_index3(x0, y1, z1, resolution), int(h->frames), int(h->frame_index));
+  const float v111 = vbt_decode_temporal_control_value(
+      payload, stream_base, codec, control_count, keyframe_count,
+      vbt_control_index3(x1, y1, z1, resolution), int(h->frames), int(h->frame_index));
+
+  const float c00 = vbt_mix_f32(v000, v100, tx);
+  const float c10 = vbt_mix_f32(v010, v110, tx);
+  const float c01 = vbt_mix_f32(v001, v101, tx);
+  const float c11 = vbt_mix_f32(v011, v111, tx);
+  return vbt_mix_f32(vbt_mix_f32(c00, c10, ty), vbt_mix_f32(c01, c11, ty), tz);
+}
+
+ccl_device_inline float vbt_sample_density_leaf_index(const VBTPayloadView vbt,
+                                                      const float x,
+                                                      const float y,
+                                                      const float z)
+{
+  ccl_global const KernelVBTHeader *h = vbt.header;
+  if (h->magic != KERNEL_VBT_BLOB_MAGIC || x < 0.0f || y < 0.0f || z < 0.0f ||
+      x > float(h->dim_x - 1u) || y > float(h->dim_y - 1u) || z > float(h->dim_z - 1u))
+  {
+    return 0.0f;
+  }
+
+  const uint xi = vbt_min_u32(h->dim_x - 1u, uint(x));
+  const uint yi = vbt_min_u32(h->dim_y - 1u, uint(y));
+  const uint zi = vbt_min_u32(h->dim_z - 1u, uint(z));
+  const uint bx = vbt_min_u32(h->leaf_count_x - 1u, xi / h->leaf_size);
+  const uint by = vbt_min_u32(h->leaf_count_y - 1u, yi / h->leaf_size);
+  const uint bz = vbt_min_u32(h->leaf_count_z - 1u, zi / h->leaf_size);
+  const uint leaf_index = (bz * h->leaf_count_y + by) * h->leaf_count_x + bx;
+
+  const uint word_begin = vbt.offset_words[leaf_index];
+  const uint word_end = vbt.offset_words[leaf_index + 1u];
+  if (word_end <= word_begin) {
+    return 0.0f;
+  }
+
+  const uint leaf_base_byte = word_begin * 4u;
+  const uint packed_header = vbt.payload_words[word_begin];
+  const uint mode = packed_header & 0x3u;
+  if (mode == VBT_MODE_EMPTY || mode == VBT_MODE_TEMPORAL_FINE_COMPACT_RESERVED) {
+    return 0.0f;
+  }
+
+  const uint coarse_codec = (packed_header >> 2u) & 0x3u;
+  const uint fine_codec = (packed_header >> 4u) & 0x3u;
+  const uint coarse_resolution = (packed_header >> 6u) & 0x7u;
+  const uint fine_resolution = (packed_header >> 9u) & 0x7u;
+  const uint coarse_keyframe_count = vbt_read_payload_u16(vbt.payload_words, leaf_base_byte + 4u);
+  const uint fine_keyframe_count = vbt_read_payload_u16(vbt.payload_words, leaf_base_byte + 6u);
+
+  const uint coarse_control_count = coarse_resolution * coarse_resolution * coarse_resolution;
+  const uint coarse_descriptor_bytes = coarse_control_count * 4u;
+  const uint coarse_bin_bytes = vbt_align_up4(coarse_control_count * VBT_TIME_BIN_COUNT);
+  const uint coarse_keyframe_stride = coarse_codec == 1u ? 8u : 3u;
+  const uint coarse_keyframe_bytes = vbt_align_up4(coarse_keyframe_count * coarse_keyframe_stride);
+  const uint coarse_stream_base = leaf_base_byte + 8u;
+  const uint fine_stream_base = coarse_stream_base + coarse_descriptor_bytes + coarse_bin_bytes +
+                                coarse_keyframe_bytes;
+
+  const uint base_x = bx * h->leaf_size;
+  const uint base_y = by * h->leaf_size;
+  const uint base_z = bz * h->leaf_size;
+  const uint leaf_width = vbt_min_u32(h->leaf_size, h->dim_x - base_x);
+  const uint leaf_height = vbt_min_u32(h->leaf_size, h->dim_y - base_y);
+  const uint leaf_depth = vbt_min_u32(h->leaf_size, h->dim_z - base_z);
+  const float lx = x - float(base_x);
+  const float ly = y - float(base_y);
+  const float lz = z - float(base_z);
+
+  float value = vbt_sample_control_stream(vbt,
+                                          coarse_stream_base,
+                                          coarse_codec,
+                                          coarse_resolution,
+                                          coarse_keyframe_count,
+                                          leaf_width,
+                                          leaf_height,
+                                          leaf_depth,
+                                          lx,
+                                          ly,
+                                          lz);
+
+  if (mode == VBT_MODE_TEMPORAL_FINE6 && fine_resolution > 0u) {
+    value += vbt_sample_control_stream(vbt,
+                                       fine_stream_base,
+                                       fine_codec,
+                                       fine_resolution,
+                                       fine_keyframe_count,
+                                       leaf_width,
+                                       leaf_height,
+                                       leaf_depth,
+                                       lx,
+                                       ly,
+                                       lz);
+  }
+
+  return value;
+}
+
+ccl_device_inline float vbt_sample_density_index(const VBTPayloadView vbt,
+                                                 const float x,
+                                                 const float y,
+                                                 const float z)
+{
+  ccl_global const KernelVBTHeader *h = vbt.header;
+  if (h->magic != KERNEL_VBT_BLOB_MAGIC || x < 0.0f || y < 0.0f || z < 0.0f ||
+      x > float(h->dim_x - 1u) || y > float(h->dim_y - 1u) || z > float(h->dim_z - 1u))
+  {
+    return 0.0f;
+  }
+
+  const uint x0 = vbt_min_u32(h->dim_x - 1u, uint(x));
+  const uint y0 = vbt_min_u32(h->dim_y - 1u, uint(y));
+  const uint z0 = vbt_min_u32(h->dim_z - 1u, uint(z));
+  const uint x1 = vbt_min_u32(h->dim_x - 1u, x0 + 1u);
+  const uint y1 = vbt_min_u32(h->dim_y - 1u, y0 + 1u);
+  const uint z1 = vbt_min_u32(h->dim_z - 1u, z0 + 1u);
+
+  const float tx = x1 > x0 ? x - float(x0) : 0.0f;
+  const float ty = y1 > y0 ? y - float(y0) : 0.0f;
+  const float tz = z1 > z0 ? z - float(z0) : 0.0f;
+
+  const float v000 = vbt_sample_density_leaf_index(vbt, float(x0), float(y0), float(z0));
+  const float v100 = vbt_sample_density_leaf_index(vbt, float(x1), float(y0), float(z0));
+  const float v010 = vbt_sample_density_leaf_index(vbt, float(x0), float(y1), float(z0));
+  const float v110 = vbt_sample_density_leaf_index(vbt, float(x1), float(y1), float(z0));
+  const float v001 = vbt_sample_density_leaf_index(vbt, float(x0), float(y0), float(z1));
+  const float v101 = vbt_sample_density_leaf_index(vbt, float(x1), float(y0), float(z1));
+  const float v011 = vbt_sample_density_leaf_index(vbt, float(x0), float(y1), float(z1));
+  const float v111 = vbt_sample_density_leaf_index(vbt, float(x1), float(y1), float(z1));
+
+  const float c00 = vbt_mix_f32(v000, v100, tx);
+  const float c10 = vbt_mix_f32(v010, v110, tx);
+  const float c01 = vbt_mix_f32(v001, v101, tx);
+  const float c11 = vbt_mix_f32(v011, v111, tx);
+  return vbt_mix_f32(vbt_mix_f32(c00, c10, ty), vbt_mix_f32(c01, c11, ty), tz);
+}
+
+ccl_device_inline float kernel_image_interp_vbt_density(const ccl_global KernelImageInfo &info,
+                                                        const float3 P)
+{
+  if (info.data == 0) {
+    return 0.0f;
+  }
+
+  ccl_global const KernelVBTHeader *header = (ccl_global const KernelVBTHeader *)info.data;
+  if (header->magic != KERNEL_VBT_BLOB_MAGIC) {
+    return 0.0f;
+  }
+
+  const VBTPayloadView vbt = {header, vbt_blob_offsets(header), vbt_blob_payload(header)};
+  return vbt_sample_density_index(vbt, P.x, P.y, P.z);
+}
+
+CCL_NAMESPACE_END
