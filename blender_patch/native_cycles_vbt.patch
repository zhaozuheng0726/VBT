diff --git a/intern/cycles/scene/image_vbt.cpp b/intern/cycles/scene/image_vbt.cpp
new file mode 100644
index 00000000..83ada7e0
--- /dev/null
+++ b/intern/cycles/scene/image_vbt.cpp
@@ -0,0 +1,229 @@
+/* SPDX-FileCopyrightText: 2026
+ *
+ * SPDX-License-Identifier: Apache-2.0 */
+
+#include "scene/image_vbt.h"
+
+#include "util/image_metadata.h"
+#include "util/log.h"
+#include "util/transform.h"
+#include "util/types_image.h"
+
+#include <algorithm>
+#include <cstring>
+#include <fstream>
+
+CCL_NAMESPACE_BEGIN
+
+namespace {
+
+enum : uint32_t {
+  VBT_FIELD_DENSITY = 1u,
+};
+
+struct VBTPack4Header {
+  char magic[8];
+  uint32_t version;
+  uint32_t width;
+  uint32_t height;
+  uint32_t depth;
+  uint32_t frames;
+  uint32_t leaf_size;
+  uint32_t coarse_resolution;
+  uint32_t max_coarse_keep;
+  uint32_t leaf_count;
+  uint32_t profile_type;
+  uint32_t coarse_ac_scale_count;
+};
+
+template<typename T> bool read_value(std::ifstream &in, T &value)
+{
+  in.read(reinterpret_cast<char *>(&value), sizeof(T));
+  return static_cast<bool>(in);
+}
+
+uint32_t div_round_up_u32(const uint32_t value, const uint32_t divisor)
+{
+  return divisor == 0u ? 0u : (value + divisor - 1u) / divisor;
+}
+
+size_t align_up_4(const size_t value)
+{
+  return (value + 3u) & ~size_t(3u);
+}
+
+}  // namespace
+
+VBTImageLoader::VBTImageLoader(const string &filepath, const int frame_index)
+    : filepath(filepath), frame_index(frame_index)
+{
+}
+
+VBTImageLoader::~VBTImageLoader() = default;
+
+bool VBTImageLoader::load_vbt_blob(string &error)
+{
+  if (!blob.empty()) {
+    return true;
+  }
+
+  std::ifstream in(filepath, std::ios::binary);
+  if (!in) {
+    error = "Failed to open VBT file: " + filepath;
+    return false;
+  }
+
+  VBTPack4Header file_header = {};
+  in.read(file_header.magic, sizeof(file_header.magic));
+  if (!in || !read_value(in, file_header.version) || !read_value(in, file_header.width) ||
+      !read_value(in, file_header.height) || !read_value(in, file_header.depth) ||
+      !read_value(in, file_header.frames) || !read_value(in, file_header.leaf_size) ||
+      !read_value(in, file_header.coarse_resolution) ||
+      !read_value(in, file_header.max_coarse_keep) || !read_value(in, file_header.leaf_count) ||
+      !read_value(in, file_header.profile_type) ||
+      !read_value(in, file_header.coarse_ac_scale_count))
+  {
+    error = "Failed to read VBTPACK4 header: " + filepath;
+    return false;
+  }
+
+  if (std::strncmp(file_header.magic, "VBTPACK4", 8) != 0) {
+    error = "Unsupported VBT magic in " + filepath + ". Expected VBTPACK4.";
+    return false;
+  }
+  if (file_header.profile_type != VBT_FIELD_DENSITY) {
+    error = "Native Cycles VBT MVP only supports density VBTPACK4 files: " + filepath;
+    return false;
+  }
+  if (file_header.width == 0u || file_header.height == 0u || file_header.depth == 0u ||
+      file_header.frames == 0u || file_header.leaf_count == 0u)
+  {
+    error = "Invalid empty VBT dimensions or frame count: " + filepath;
+    return false;
+  }
+
+  const uint32_t leaf_size = file_header.leaf_size == 0u ? 8u : file_header.leaf_size;
+  const uint32_t leaf_count_x = div_round_up_u32(file_header.width, leaf_size);
+  const uint32_t leaf_count_y = div_round_up_u32(file_header.height, leaf_size);
+  const uint32_t leaf_count_z = div_round_up_u32(file_header.depth, leaf_size);
+  const uint64_t expected_leaf_count = uint64_t(leaf_count_x) * uint64_t(leaf_count_y) *
+                                       uint64_t(leaf_count_z);
+  if (expected_leaf_count != uint64_t(file_header.leaf_count)) {
+    error = "VBT leaf count does not match dimensions in " + filepath;
+    return false;
+  }
+
+  const uint64_t scale_bytes = uint64_t(file_header.coarse_ac_scale_count) * sizeof(float);
+  in.seekg(static_cast<std::streamoff>(scale_bytes), std::ios::cur);
+  if (!in) {
+    error = "Failed to skip VBT coarse AC scales: " + filepath;
+    return false;
+  }
+
+  vector<uint32_t> offsets(file_header.leaf_count + 1u);
+  in.read(reinterpret_cast<char *>(offsets.data()),
+          static_cast<std::streamsize>(offsets.size() * sizeof(uint32_t)));
+  if (!in) {
+    error = "Failed to read VBT offset table: " + filepath;
+    return false;
+  }
+
+  const uint32_t payload_word_count = offsets.back();
+  vector<uint32_t> payload(payload_word_count);
+  if (payload_word_count > 0u) {
+    in.read(reinterpret_cast<char *>(payload.data()),
+            static_cast<std::streamsize>(payload.size() * sizeof(uint32_t)));
+    if (!in) {
+      error = "Failed to read VBT payload pool: " + filepath;
+      return false;
+    }
+  }
+
+  const size_t offsets_byte_offset = align_up_4(sizeof(KernelVBTHeader));
+  const size_t payload_byte_offset = offsets_byte_offset + offsets.size() * sizeof(uint32_t);
+  const size_t blob_bytes = payload_byte_offset + payload.size() * sizeof(uint32_t);
+
+  blob.assign(blob_bytes, 0);
+
+  KernelVBTHeader header = {};
+  header.magic = KERNEL_VBT_BLOB_MAGIC;
+  header.version = 1u;
+  header.dim_x = file_header.width;
+  header.dim_y = file_header.height;
+  header.dim_z = file_header.depth;
+  header.frames = file_header.frames;
+  header.leaf_size = leaf_size;
+  header.leaf_count_x = leaf_count_x;
+  header.leaf_count_y = leaf_count_y;
+  header.leaf_count_z = leaf_count_z;
+  header.leaf_count = file_header.leaf_count;
+  header.frame_index = uint32_t(std::clamp(frame_index, 0, int(file_header.frames) - 1));
+  header.offsets_word_count = uint32_t(offsets.size());
+  header.payload_word_count = payload_word_count;
+  header.offsets_byte_offset = uint32_t(offsets_byte_offset);
+  header.payload_byte_offset = uint32_t(payload_byte_offset);
+
+  memcpy(blob.data(), &header, sizeof(header));
+  memcpy(blob.data() + offsets_byte_offset, offsets.data(), offsets.size() * sizeof(uint32_t));
+  if (!payload.empty()) {
+    memcpy(blob.data() + payload_byte_offset, payload.data(), payload.size() * sizeof(uint32_t));
+  }
+
+  return true;
+}
+
+bool VBTImageLoader::load_metadata(ImageMetaData &metadata,
+                                   const ImageLoaderParams & /*params*/,
+                                   Progress & /*progress*/)
+{
+  string error;
+  if (!load_vbt_blob(error)) {
+    LOG_ERROR << error;
+    return false;
+  }
+
+  const KernelVBTHeader *header = reinterpret_cast<const KernelVBTHeader *>(blob.data());
+
+  metadata.channels = 1;
+  metadata.width = int64_t(blob.size());
+  metadata.height = 0;
+  metadata.type = IMAGE_DATA_TYPE_VBT_DENSITY;
+  metadata.nanovdb_byte_size = int64_t(blob.size());
+  metadata.colorspace = u_colorspace_data;
+  metadata.use_transform_3d = true;
+
+  const float sx = float(std::max(header->dim_x, 1u) - 1u);
+  const float sy = float(std::max(header->dim_y, 1u) - 1u);
+  const float sz = float(std::max(header->dim_z, 1u) - 1u);
+  metadata.transform_3d = transform_scale(make_float3(sx, sy, sz));
+
+  return true;
+}
+
+bool VBTImageLoader::load_pixels(const ImageMetaData &metadata, void *pixels)
+{
+  if (metadata.type != IMAGE_DATA_TYPE_VBT_DENSITY || blob.empty()) {
+    return false;
+  }
+  memcpy(pixels, blob.data(), blob.size());
+  return true;
+}
+
+string VBTImageLoader::name() const
+{
+  return filepath;
+}
+
+bool VBTImageLoader::equals(const ImageLoader &other) const
+{
+  const VBTImageLoader *other_loader = dynamic_cast<const VBTImageLoader *>(&other);
+  return other_loader && filepath == other_loader->filepath &&
+         frame_index == other_loader->frame_index;
+}
+
+void VBTImageLoader::cleanup()
+{
+  blob.free_memory();
+}
