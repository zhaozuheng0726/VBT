#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

struct SmokeRayPacked {
    vec4 originTmin;
    vec4 dirTmax;
};

layout(std430, binding = 0) writeonly buffer RayBuffer {
    SmokeRayPacked rays[];
};

layout(push_constant) uniform PushConstants {
    uint imageWidth;
    uint imageHeight;
    float bboxMinX;
    float bboxMinY;
    float bboxMinZ;
    float bboxMaxX;
    float bboxMaxY;
    float bboxMaxZ;
    float yaw;
    float pitch;
    float distance;
    float fieldOfView;
    float targetOffsetX;
    float targetOffsetY;
    float targetOffsetZ;
    uint upAxis;
} pc;

bool intersectBox(vec3 origin, vec3 direction, vec3 maximum, out float nearT, out float farT)
{
    vec3 inverseDirection = 1.0 / direction;
    vec3 first = (vec3(0.0) - origin) * inverseDirection;
    vec3 second = (maximum - origin) * inverseDirection;
    vec3 minimumT = min(first, second);
    vec3 maximumT = max(first, second);
    nearT = max(0.0, max(minimumT.x, max(minimumT.y, minimumT.z)));
    farT = min(maximumT.x, min(maximumT.y, maximumT.z));
    return farT > nearT;
}

void main()
{
    uvec2 pixel = gl_GlobalInvocationID.xy;
    if (pixel.x >= pc.imageWidth || pixel.y >= pc.imageHeight) return;

    vec3 minimum = vec3(pc.bboxMinX, pc.bboxMinY, pc.bboxMinZ);
    vec3 maximum = vec3(pc.bboxMaxX, pc.bboxMaxY, pc.bboxMaxZ);
    vec3 center = (minimum + maximum) * 0.5;
    vec3 size = maximum - minimum;
    float extent = max(size.x, max(size.y, size.z));
    vec3 target = center + vec3(pc.targetOffsetX, pc.targetOffsetY, pc.targetOffsetZ) * extent;
    vec3 orbit = pc.upAxis == 2u
                     ? vec3(cos(pc.pitch) * sin(pc.yaw), cos(pc.pitch) * cos(pc.yaw), sin(pc.pitch))
                     : vec3(cos(pc.pitch) * sin(pc.yaw), sin(pc.pitch), cos(pc.pitch) * cos(pc.yaw));
    vec3 camera = target + orbit * (extent * pc.distance);
    vec3 forward = normalize(target - camera);
    vec3 worldUp = pc.upAxis == 2u ? vec3(0.0, 0.0, 1.0) : vec3(0.0, 1.0, 0.0);
    vec3 right = normalize(cross(forward, worldUp));
    vec3 up = normalize(cross(right, forward));
    float aspect = float(pc.imageWidth) / float(pc.imageHeight);
    float tangent = tan(radians(pc.fieldOfView) * 0.5);
    float screenX = (2.0 * (float(pixel.x) + 0.5) / float(pc.imageWidth) - 1.0) * aspect * tangent;
    float screenY = (1.0 - 2.0 * (float(pixel.y) + 0.5) / float(pc.imageHeight)) * tangent;
    vec3 direction = normalize(forward + right * screenX + up * screenY);

    uint index = pixel.y * pc.imageWidth + pixel.x;
    float nearT;
    float farT;
    float localNearT;
    float localFarT;
    if (intersectBox(camera - minimum, direction, size, localNearT, localFarT)) {
        nearT = localNearT;
        farT = localFarT;
        vec3 entry = camera + direction * nearT;
        rays[index].originTmin = vec4(entry, 0.0);
        rays[index].dirTmax = vec4(direction, farT - nearT);
    }
    else {
        rays[index].originTmin = vec4(camera, 0.0);
        rays[index].dirTmax = vec4(direction, 0.0);
    }
}
